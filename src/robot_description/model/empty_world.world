<?xml version="1.0" ?>
<sdf version="1.6">

<world name="default">

  <!-- Light -->
  <include>
    <uri>model://sun</uri>
  </include>

  <!-- Ground -->
  <include>
    <uri>model://ground_plane</uri>
  </include>


  <!-- ===================== -->
  <!-- 6 TRAFFIC CONES -->
  <!-- ===================== -->

  <include>
    <name>cone_1</name>
    <uri>model://traffic_cone</uri>
    <pose>2.5 0 0 0 0 0</pose>
  </include>


  <include>
    <name>cone_2</name>
    <uri>model://traffic_cone</uri>
    <pose>3.5 1 0 0 0 0</pose>
  </include>


  <include>
    <name>cone_3</name>
    <uri>model://traffic_cone</uri>
    <pose>4.5 -1 0 0 0 0</pose>
  </include>


  <include>
    <name>cone_4</name>
    <uri>model://traffic_cone</uri>
    <pose>5.5 1.5 0 0 0 0</pose>
  </include>


  <include>
    <name>cone_5</name>
    <uri>model://traffic_cone</uri>
    <pose>6.5 -1.5 0 0 0 0</pose>
  </include>


  <include>
    <name>cone_6</name>
    <uri>model://traffic_cone</uri>
    <pose>7.5 0 0 0 0 0</pose>
  </include>


</world>

</sdf>
