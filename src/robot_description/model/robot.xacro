<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="mobile_robot">


  <!-- ================================================= -->
  <!-- BASE FOOTPRINT -->
  <!-- ================================================= -->



  <!-- ================================================= -->
  <!-- BASE BODY -->
  <!-- ================================================= -->

  <link name="base_link">

    <visual>

      <origin xyz="0 0 0.25"
              rpy="0 0 0"/>

      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>

      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>

    </visual>


    <collision>

      <origin xyz="0 0 0.25"
              rpy="0 0 0"/>

      <geometry>
        <box size="1.0 0.6 0.3"/>
      </geometry>

    </collision>


    <inertial>

      <origin xyz="0 0 0.25"
              rpy="0 0 0"/>

      <mass value="5"/>

      <inertia
        ixx="0.1"
        ixy="0"
        ixz="0"
        iyy="0.1"
        iyz="0"
        izz="0.1"/>

    </inertial>

  </link>


  <!-- ================================================= -->
  <!-- BASE JOINT -->
  <!-- ================================================= -->

 


  <!-- ================================================= -->
  <!-- LEFT REAR WHEEL -->
  <!-- ================================================= -->

  <link name="left_wheel_link">

    <visual>

      <origin xyz="0 0 0"
              rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.14"
                  length="0.12"/>
      </geometry>

      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>

    </visual>


    <collision>

      <origin xyz="0 0 0"
              rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.14"
                  length="0.12"/>
      </geometry>

    </collision>


    <inertial>

      <mass value="1"/>

      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>

    </inertial>

  </link>


  <!-- LEFT WHEEL JOINT -->

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="left_wheel_link"/>

    <origin xyz="-0.35 0.36 0.14"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- RIGHT REAR WHEEL -->
  <!-- ================================================= -->

  <link name="right_wheel_link">

    <visual>

      <origin xyz="0 0 0"
              rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.14"
                  length="0.12"/>
      </geometry>

      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>

    </visual>


    <collision>

      <origin xyz="0 0 0"
              rpy="1.5708 0 0"/>

      <geometry>
        <cylinder radius="0.14"
                  length="0.12"/>
      </geometry>

    </collision>


    <inertial>

      <mass value="1"/>

      <inertia
        ixx="0.01"
        ixy="0"
        ixz="0"
        iyy="0.01"
        iyz="0"
        izz="0.01"/>

    </inertial>

  </link>


  <!-- RIGHT WHEEL JOINT -->

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>

    <child link="right_wheel_link"/>

    <origin xyz="-0.35 -0.36 0.14"
            rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- FRONT CASTER -->
  <!-- ================================================= -->

  <link name="caster_wheel_link">

    <visual>

      <geometry>
        <sphere radius="0.10"/>
      </geometry>

      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>

    </visual>


    <collision>

      <geometry>
        <sphere radius="0.10"/>
      </geometry>

    </collision>


    <inertial>

      <mass value="0.2"/>

      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>

    </inertial>

  </link>


  <!-- CASTER JOINT -->

  <joint name="caster_wheel_joint"
         type="fixed">

    <parent link="base_link"/>

    <child link="caster_wheel_link"/>

    <origin xyz="0.40 0 0.10"
            rpy="0 0 0"/>

  </joint>


  <!-- ================================================= -->
  <!-- LIDAR -->
  <!-- ================================================= -->

  <link name="lidar_link">

    <visual>

      <origin xyz="0 0 0"
              rpy="0 0 0"/>

      <geometry>
        <cylinder radius="0.06"
                  length="0.04"/>
      </geometry>

      <material name="lidar_gray">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>

    </visual>




    <inertial>

      <mass value="0.1"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>

    </inertial>

  </link>


  <!-- LIDAR JOINT -->

  <joint name="lidar_joint"
         type="fixed">

    <parent link="base_link"/>

    <child link="lidar_link"/>

     <origin xyz="0 0 0.45"
        rpy="0 0 0"/>

  </joint>
<!-- ================= CAMERA ================= -->

<link name="camera_link">

  <visual>
    <geometry>
      <box size="0.08 0.05 0.05"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <box size="0.08 0.05 0.05"/>
    </geometry>
  </collision>

  <inertial>
    <mass value="0.05"/>
    <inertia
      ixx="0.0001"
      ixy="0"
      ixz="0"
      iyy="0.0001"
      iyz="0"
      izz="0.0001"/>
  </inertial>

</link>

<joint name="camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="camera_link"/>
  <origin xyz="0.35 0 0.42" rpy="0 0 0"/>
</joint>
<!-- ================= CAMERA SENSOR ================= -->

<gazebo reference="camera_link">

  <sensor type="camera" name="camera_sensor">

    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>

    <camera>
      <horizontal_fov>1.047</horizontal_fov>

      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>20.0</far>
      </clip>
    </camera>

    <plugin
      name="gazebo_ros_camera"
      filename="libgazebo_ros_camera.so">

      <ros>
        <remapping>image_raw:=camera/image_raw</remapping>
        <remapping>camera_info:=camera/camera_info</remapping>
      </ros>

      <camera_name>camera</camera_name>
      <frame_name>camera_link</frame_name>

    </plugin>

  </sensor>

</gazebo>

  <!-- ================================================= -->
  <!-- GAZEBO CONFIGURATION -->
  <!-- ================================================= -->

  <xacro:include filename="$(find robot_description)/model/robot.gazebo"/>
<!-- ================= LIDAR ================= -->

<gazebo>
  <plugin
    name="gazebo_ros_joint_state_publisher"
    filename="libgazebo_ros_joint_state_publisher.so">

    <update_rate>50</update_rate>

    <joint_name>left_wheel_joint</joint_name>
    <joint_name>right_wheel_joint</joint_name>

  </plugin>
</gazebo>

</robot>