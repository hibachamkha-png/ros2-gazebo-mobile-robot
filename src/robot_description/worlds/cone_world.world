<?xml version="1.0"?>
<sdf version="1.6">
  <world name="cone_world">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://traffic_cone</uri>
      <name>cone_1</name>
      <pose>2 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://traffic_cone</uri>
      <name>cone_2</name>
      <pose>-2 1 0 0 0 0</pose>
    </include>

  </world>
</sdf>
